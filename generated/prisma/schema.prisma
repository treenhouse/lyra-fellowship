// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// generator zod {
//   provider = "prisma-zod-generator"
//   output   = "../generated/zod"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())

  memberships    BaseMember[]
  recordsCreated Record[]
  tables         Table[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Base {
  id        String   @id @default(uuid())
  name      String
  ownerId   String?
  createdAt DateTime @default(now())

  tables  Table[]
  members BaseMember[]
}

model BaseMember {
  baseId String
  userId String

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([baseId, userId])
}

model Table {
  id          String   @id @default(uuid())
  baseId      String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  base    Base  @relation(fields: [baseId], references: [id], onDelete: Cascade)
  creator User? @relation(fields: [createdById], references: [id])

  fields  Field[]
  records Record[]
  views   View[]
}

enum FieldType {
  text
  number
}

model Field {
  id       String    @id @default(uuid())
  tableId  String
  name     String
  type     FieldType
  position Int?

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  cells       CellValue[]
  viewFilters ViewFilter[]
  viewSorts   ViewSort[]

  @@unique([tableId, name])
}

model Record {
  id        String   @id @default(uuid())
  tableId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  position  Int?

  table           Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  cells           CellValue[]
  user            User?       @relation(fields: [userId], references: [id])
  userId          String?
  sortValueText   String?
  sortValueNumber Float?
}

model CellValue {
  recordId    String
  fieldId     String
  valueText   String?
  valueNumber Float?

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  field  Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([recordId, fieldId])
  @@index([fieldId])
  @@index([recordId])
  @@index([fieldId, valueText])
  @@index([fieldId, valueNumber])
}

model View {
  id        String   @id @default(uuid())
  tableId   String
  name      String
  position  Int?
  createdAt DateTime @default(now())

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  filters ViewFilter[]
  sorts   ViewSort[]
}

model ViewFilter {
  id       String  @id @default(uuid())
  viewId   String
  fieldId  String?
  operator String  @default("equals")
  value    Json?

  view  View   @relation(fields: [viewId], references: [id], onDelete: Cascade)
  field Field? @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model ViewSort {
  id        String        @id @default(uuid())
  viewId    String
  fieldId   String
  direction SortDirection
  order     Int?

  view  View  @relation(fields: [viewId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

enum SortDirection {
  asc
  desc
}
